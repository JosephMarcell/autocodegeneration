{
  "project": "Diagram2",
  "stack": {
    "framework": "React 18",
    "language": "TypeScript",
    "router": "React Router v6",
    "styling": "Tailwind CSS",
    "stateLib": "Zustand",
    "stateImport": "src/shared/state/globalState.ts"
  },
  "sharedContext": {
    "roles": [
      {
        "display": "Main Process",
        "value": "mainprocess",
        "internal": "mainprocess"
      },
      {
        "display": "Make new unit",
        "value": "makenewunit",
        "internal": "makenewunit"
      }
    ],
    "defaultRoutesPerRole": {
      "makenewunit": "/make-new-unit/asks-to-make-new-unit"
    },
    "stateSchema": {
      "asks_to_make_new_unit_completed": false,
      "saves_the_new_unit_completed": false,
      "enters_a_new_unit_completed": false,
      "displays_form_of_make_new_unit_completed": false
    },
    "allRoutes": [
      {
        "route": "/make-new-unit/asks-to-make-new-unit",
        "role": "makenewunit",
        "component": "AsksToMakeNewUnitPage",
        "allowedRoles": [
          "makenewunit"
        ]
      },
      {
        "route": "/make-new-unit/saves-the-new-unit",
        "role": "makenewunit",
        "component": "SavesTheNewUnitPage",
        "allowedRoles": [
          "makenewunit"
        ]
      },
      {
        "route": "/make-new-unit/enters-a-new-unit",
        "role": "makenewunit",
        "component": "EntersANewUnitPage",
        "allowedRoles": [
          "makenewunit"
        ]
      },
      {
        "route": "/make-new-unit/displays-form-of-make-new-unit",
        "role": "makenewunit",
        "component": "DisplaysFormOfMakeNewUnitPage",
        "allowedRoles": [
          "makenewunit"
        ]
      }
    ]
  },
  "participants": [
    {
      "name": "MainProcess",
      "role": "mainprocess",
      "defaultRoute": "/main-process/complete",
      "tasks": []
    },
    {
      "name": "MakeNewUnit",
      "role": "makenewunit",
      "defaultRoute": "/make-new-unit/asks-to-make-new-unit",
      "tasks": [
        {
          "taskId": "makenewunit-asks-to-make-new-unit",
          "name": "AsksToMakeNewUnit",
          "route": "/make-new-unit/asks-to-make-new-unit",
          "component": "AsksToMakeNewUnitPage",
          "pageType": "write-navigate",
          "description": "Make new unit: Asks to make new unit.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "asks_to_make_new_unit_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-unit/displays-form-of-make-new-unit",
          "ui": {
            "title": "Asks to make new unit",
            "hint": "Page for BPMN task 'Asks to make new unit' (write-navigate)."
          }
        },
        {
          "taskId": "makenewunit-displays-form-of-make-new-unit",
          "name": "DisplaysFormOfMakeNewUnit",
          "route": "/make-new-unit/displays-form-of-make-new-unit",
          "component": "DisplaysFormOfMakeNewUnitPage",
          "pageType": "write-navigate",
          "description": "Make new unit: Displays form of  make new unit.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "displays_form_of_make_new_unit_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-unit/enters-a-new-unit",
          "ui": {
            "title": "Displays form of  make new unit",
            "hint": "Page for BPMN task 'Displays form of  make new unit' (write-navigate)."
          }
        },
        {
          "taskId": "makenewunit-enters-a-new-unit",
          "name": "EntersANewUnit",
          "route": "/make-new-unit/enters-a-new-unit",
          "component": "EntersANewUnitPage",
          "pageType": "write-navigate",
          "description": "Make new unit: Enters a new unit.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "enters_a_new_unit_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-unit/saves-the-new-unit",
          "ui": {
            "title": "Enters a new unit",
            "hint": "Page for BPMN task 'Enters a new unit' (write-navigate)."
          },
          "conditionalRoutes": [
            {
              "route": "/make-new-unit/saves-the-new-unit",
              "condition": "Add"
            }
          ]
        },
        {
          "taskId": "makenewunit-saves-the-new-unit",
          "name": "SavesTheNewUnit",
          "route": "/make-new-unit/saves-the-new-unit",
          "component": "SavesTheNewUnitPage",
          "pageType": "write-navigate",
          "description": "Make new unit: Saves the new unit.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "saves_the_new_unit_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-unit/complete",
          "ui": {
            "title": "Saves the new unit",
            "hint": "Page for BPMN task 'Saves the new unit' (write-navigate)."
          }
        }
      ]
    }
  ]
}