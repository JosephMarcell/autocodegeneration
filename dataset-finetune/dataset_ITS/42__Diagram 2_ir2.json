{
  "project": "Diagram2",
  "stack": {
    "framework": "React 18",
    "language": "TypeScript",
    "router": "React Router v6",
    "styling": "Tailwind CSS",
    "stateLib": "Zustand",
    "stateImport": "src/shared/state/globalState.ts"
  },
  "sharedContext": {
    "roles": [
      {
        "display": "Main Process",
        "value": "mainprocess",
        "internal": "mainprocess"
      },
      {
        "display": "Make new item category",
        "value": "makenewitemcategory",
        "internal": "makenewitemcategory"
      }
    ],
    "defaultRoutesPerRole": {
      "makenewitemcategory": "/make-new-item-category/asks-to-make-new-item-category"
    },
    "stateSchema": {
      "asks_to_make_new_item_category_completed": false,
      "saves_the_new_category_completed": false,
      "enters_a_new_category_completed": false,
      "displays_form_of_make_new_item_category_completed": false
    },
    "allRoutes": [
      {
        "route": "/make-new-item-category/asks-to-make-new-item-category",
        "role": "makenewitemcategory",
        "component": "AsksToMakeNewItemCategoryPage",
        "allowedRoles": [
          "makenewitemcategory"
        ]
      },
      {
        "route": "/make-new-item-category/saves-the-new-category",
        "role": "makenewitemcategory",
        "component": "SavesTheNewCategoryPage",
        "allowedRoles": [
          "makenewitemcategory"
        ]
      },
      {
        "route": "/make-new-item-category/enters-a-new-category",
        "role": "makenewitemcategory",
        "component": "EntersANewCategoryPage",
        "allowedRoles": [
          "makenewitemcategory"
        ]
      },
      {
        "route": "/make-new-item-category/displays-form-of-make-new-item-category",
        "role": "makenewitemcategory",
        "component": "DisplaysFormOfMakeNewItemCategoryPage",
        "allowedRoles": [
          "makenewitemcategory"
        ]
      }
    ]
  },
  "participants": [
    {
      "name": "MainProcess",
      "role": "mainprocess",
      "defaultRoute": "/main-process/complete",
      "tasks": []
    },
    {
      "name": "MakeNewItemCategory",
      "role": "makenewitemcategory",
      "defaultRoute": "/make-new-item-category/asks-to-make-new-item-category",
      "tasks": [
        {
          "taskId": "makenewitemcategory-asks-to-make-new-item-category",
          "name": "AsksToMakeNewItemCategory",
          "route": "/make-new-item-category/asks-to-make-new-item-category",
          "component": "AsksToMakeNewItemCategoryPage",
          "pageType": "write-navigate",
          "description": "Make new item category: Asks to make new item category.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "asks_to_make_new_item_category_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-item-category/displays-form-of-make-new-item-category",
          "ui": {
            "title": "Asks to make new item category",
            "hint": "Page for BPMN task 'Asks to make new item category' (write-navigate)."
          }
        },
        {
          "taskId": "makenewitemcategory-displays-form-of-make-new-item-category",
          "name": "DisplaysFormOfMakeNewItemCategory",
          "route": "/make-new-item-category/displays-form-of-make-new-item-category",
          "component": "DisplaysFormOfMakeNewItemCategoryPage",
          "pageType": "write-navigate",
          "description": "Make new item category: Displays form of  make new item category.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "displays_form_of_make_new_item_category_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-item-category/enters-a-new-category",
          "ui": {
            "title": "Displays form of  make new item category",
            "hint": "Page for BPMN task 'Displays form of  make new item category' (write-navigate)."
          }
        },
        {
          "taskId": "makenewitemcategory-enters-a-new-category",
          "name": "EntersANewCategory",
          "route": "/make-new-item-category/enters-a-new-category",
          "component": "EntersANewCategoryPage",
          "pageType": "write-navigate",
          "description": "Make new item category: Enters a new category.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "enters_a_new_category_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-item-category/saves-the-new-category",
          "ui": {
            "title": "Enters a new category",
            "hint": "Page for BPMN task 'Enters a new category' (write-navigate)."
          },
          "conditionalRoutes": [
            {
              "route": "/make-new-item-category/saves-the-new-category",
              "condition": "Add"
            }
          ]
        },
        {
          "taskId": "makenewitemcategory-saves-the-new-category",
          "name": "SavesTheNewCategory",
          "route": "/make-new-item-category/saves-the-new-category",
          "component": "SavesTheNewCategoryPage",
          "pageType": "write-navigate",
          "description": "Make new item category: Saves the new category.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "saves_the_new_category_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/make-new-item-category/complete",
          "ui": {
            "title": "Saves the new category",
            "hint": "Page for BPMN task 'Saves the new category' (write-navigate)."
          }
        }
      ]
    }
  ]
}