    {
      "name": "ViewTodayTriageResults",
      "role": "viewtodaytriageresults",
      "defaultRoute": "/view-today-triage-results/wants-to-view-today-triage-results",
      "tasks": [
        {
          "taskId": "viewtodaytriageresults-wants-to-view-today-triage-results",
