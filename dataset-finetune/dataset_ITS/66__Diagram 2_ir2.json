{
  "project": "Diagram2",
  "stack": {
    "framework": "React 18",
    "language": "TypeScript",
    "router": "React Router v6",
    "styling": "Tailwind CSS",
    "stateLib": "Zustand",
    "stateImport": "src/shared/state/globalState.ts"
  },
  "sharedContext": {
    "roles": [
      {
        "display": "Main Process",
        "value": "mainprocess",
        "internal": "mainprocess"
      },
      {
        "display": "View Today Triage results",
        "value": "viewtodaytriageresults",
        "internal": "viewtodaytriageresults"
      }
    ],
    "defaultRoutesPerRole": {
      "viewtodaytriageresults": "/view-today-triage-results/wants-to-view-today-triage-results"
