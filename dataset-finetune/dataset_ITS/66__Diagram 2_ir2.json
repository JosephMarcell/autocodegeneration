          "route": "/view-today-triage-results/wants-to-view-today-triage-results",
          "component": "WantsToViewTodayTriageResultsPage",
          "pageType": "write-navigate",
          "description": "View Today Triage results: Wants to View Today Triage results.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "wants_to_view_today_triage_results_completed",
              "value": true
