{
  "project": "Diagram2",
  "stack": {
    "framework": "React 18",
    "language": "TypeScript",
    "router": "React Router v6",
    "styling": "Tailwind CSS",
    "stateLib": "Zustand",
    "stateImport": "src/shared/state/globalState.ts"
  },
  "sharedContext": {
    "roles": [
      {
        "display": "Main Process",
        "value": "mainprocess",
        "internal": "mainprocess"
      },
      {
        "display": "Update item",
        "value": "updateitem",
        "internal": "updateitem"
      }
    ],
    "defaultRoutesPerRole": {
      "updateitem": "/update-item/asks-to-update-new-item"
    },
    "stateSchema": {
      "asks_to_update_new_item_completed": false,
      "queries_for_goods_in_the_goods_database_completed": false,
      "enters_a_barcode_completed": false,
      "displays_form_of_update_item_completed": false,
      "displays_the_query_results_completed": false,
      "updates_the_item_information_completed": false,
      "save_the_new_item_information_completed": false
    },
    "allRoutes": [
      {
        "route": "/update-item/asks-to-update-new-item",
        "role": "updateitem",
        "component": "AsksToUpdateNewItemPage",
        "allowedRoles": [
          "updateitem"
        ]
      },
      {
        "route": "/update-item/queries-for-goods-in-the-goods-database",
        "role": "updateitem",
        "component": "QueriesForGoodsInTheGoodsDatabasePage",
        "allowedRoles": [
          "updateitem"
        ]
      },
      {
        "route": "/update-item/enters-a-barcode",
        "role": "updateitem",
        "component": "EntersABarcodePage",
        "allowedRoles": [
          "updateitem"
        ]
      },
      {
        "route": "/update-item/displays-form-of-update-item",
        "role": "updateitem",
        "component": "DisplaysFormOfUpdateItemPage",
        "allowedRoles": [
          "updateitem"
        ]
      },
      {
        "route": "/update-item/displays-the-query-results",
        "role": "updateitem",
        "component": "DisplaysTheQueryResultsPage",
        "allowedRoles": [
          "updateitem"
        ]
      },
      {
        "route": "/update-item/updates-the-item-information",
        "role": "updateitem",
        "component": "UpdatesTheItemInformationPage",
        "allowedRoles": [
          "updateitem"
        ]
      },
      {
        "route": "/update-item/save-the-new-item-information",
        "role": "updateitem",
        "component": "SaveTheNewItemInformationPage",
        "allowedRoles": [
          "updateitem"
        ]
      }
    ]
  },
  "participants": [
    {
      "name": "MainProcess",
      "role": "mainprocess",
      "defaultRoute": "/main-process/complete",
      "tasks": []
    },
    {
      "name": "UpdateItem",
      "role": "updateitem",
      "defaultRoute": "/update-item/asks-to-update-new-item",
      "tasks": [
        {
          "taskId": "updateitem-asks-to-update-new-item",
          "name": "AsksToUpdateNewItem",
          "route": "/update-item/asks-to-update-new-item",
          "component": "AsksToUpdateNewItemPage",
          "pageType": "write-navigate",
          "description": "Update item: Asks to update new item.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "asks_to_update_new_item_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/update-item/displays-form-of-update-item",
          "ui": {
            "title": "Asks to update new item",
            "hint": "Page for BPMN task 'Asks to update new item' (write-navigate)."
          }
        },
        {
          "taskId": "updateitem-displays-form-of-update-item",
