      "role": "mainprocess",
      "defaultRoute": "/main-process/complete",
      "tasks": []
    },
    {
      "name": "AddNewItem",
      "role": "addnewitem",
      "defaultRoute": "/add-new-item/asks-to-add-new-item",
      "tasks": [
        {
          "taskId": "addnewitem-asks-to-add-new-item",
          "name": "AsksToAddNewItem",
          "route": "/add-new-item/asks-to-add-new-item",
          "component": "AsksToAddNewItemPage",
          "pageType": "write-navigate",
          "description": "Add new item: Asks to add new item.",
          "stateReads": [],
          "stateWrites": [
            {
              "field": "asks_to_add_new_item_completed",
              "value": true
            }
          ],
          "waitCondition": null,
          "autoWriteOnMount": null,
          "nextRoute": "/add-new-item/displays-form-of-add-new-item",
          "ui": {
            "title": "Asks to add new item",
            "hint": "Page for BPMN task 'Asks to add new item' (write-navigate)."
