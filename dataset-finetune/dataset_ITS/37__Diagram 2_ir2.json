{
  "project": "Diagram2",
  "stack": {
    "framework": "React 18",
    "language": "TypeScript",
    "router": "React Router v6",
    "styling": "Tailwind CSS",
    "stateLib": "Zustand",
    "stateImport": "src/shared/state/globalState.ts"
  },
  "sharedContext": {
    "roles": [
      {
        "display": "Main Process",
        "value": "mainprocess",
        "internal": "mainprocess"
      },
      {
        "display": "Add new item",
        "value": "addnewitem",
        "internal": "addnewitem"
      }
    ],
    "defaultRoutesPerRole": {
      "addnewitem": "/add-new-item/asks-to-add-new-item"
    },
    "stateSchema": {
      "asks_to_add_new_item_completed": false,
      "queries_for_goods_in_the_goods_database_completed": false,
      "enters_a_barcode_completed": false,
      "displays_form_of_add_new_item_completed": false,
      "displays_the_query_results_in_the_form_completed": false,
      "enters_the_selling_price_purchase_price_and_initial_stock_completed": false,
      "save_the_new_item_information_completed": false
    },
    "allRoutes": [
      {
        "route": "/add-new-item/asks-to-add-new-item",
        "role": "addnewitem",
        "component": "AsksToAddNewItemPage",
        "allowedRoles": [
          "addnewitem"
        ]
      },
      {
        "route": "/add-new-item/queries-for-goods-in-the-goods-database",
        "role": "addnewitem",
        "component": "QueriesForGoodsInTheGoodsDatabasePage",
        "allowedRoles": [
          "addnewitem"
        ]
      },
      {
        "route": "/add-new-item/enters-a-barcode",
        "role": "addnewitem",
        "component": "EntersABarcodePage",
        "allowedRoles": [
          "addnewitem"
        ]
      },
      {
        "route": "/add-new-item/displays-form-of-add-new-item",
        "role": "addnewitem",
        "component": "DisplaysFormOfAddNewItemPage",
        "allowedRoles": [
          "addnewitem"
        ]
      },
      {
        "route": "/add-new-item/displays-the-query-results-in-the-form",
        "role": "addnewitem",
        "component": "DisplaysTheQueryResultsInTheFormPage",
        "allowedRoles": [
          "addnewitem"
        ]
      },
      {
        "route": "/add-new-item/enters-the-selling-price-purchase-price-and-initial-stock",
        "role": "addnewitem",
        "component": "EntersTheSellingPrice,PurchasePrice,AndInitialStockPage",
        "allowedRoles": [
          "addnewitem"
        ]
      },
      {
        "route": "/add-new-item/save-the-new-item-information",
        "role": "addnewitem",
        "component": "SaveTheNewItemInformationPage",
        "allowedRoles": [
          "addnewitem"
        ]
      }
    ]
  },
