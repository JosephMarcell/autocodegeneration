{
  "project": "Diagram2",
  "stack": {
    "framework": "React 18",
    "language": "TypeScript",
    "router": "React Router v6",
    "styling": "Tailwind CSS",
    "stateLib": "Zustand",
    "stateImport": "src/shared/state/globalState.ts"
  },
  "sharedContext": {
    "roles": [
      {
        "display": "Main Process",
        "value": "mainprocess",
        "internal": "mainprocess"
      },
      {
        "display": "Display cash inflow",
        "value": "displaycashinflow",
        "internal": "displaycashinflow"
      }
    ],
    "defaultRoutesPerRole": {
      "displaycashinflow": "/display-cash-inflow/wants-to-display-cash-inflow"
    },
    "stateSchema": {
      "wants_to_display_cash_inflow_completed": false,
      "queries_about_the_cash_inflow_in_the_cash_database_completed": false,
      "fills_in_the_year_and_month_completed": false,
      "displays_the_cash_inflow_form_completed": false,
      "displays_the_query_result_completed": false,
      "prints_a_report_to_the_printer_completed": false
    },
    "allRoutes": [
