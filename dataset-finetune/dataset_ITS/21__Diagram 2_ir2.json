        "route": "/display-cash-inflow/wants-to-display-cash-inflow",
        "role": "displaycashinflow",
        "component": "WantsToDisplayCashInflowPage",
        "allowedRoles": [
          "displaycashinflow"
        ]
      },
      {
        "route": "/display-cash-inflow/queries-about-the-cash-inflow-in-the-cash-database",
        "role": "displaycashinflow",
        "component": "QueriesAboutTheCashInflowInTheCashDatabasePage",
        "allowedRoles": [
          "displaycashinflow"
        ]
      },
      {
        "route": "/display-cash-inflow/fills-in-the-year-and-month",
        "role": "displaycashinflow",
        "component": "FillsInTheYearAndMonthPage",
        "allowedRoles": [
          "displaycashinflow"
        ]
      },
      {
        "route": "/display-cash-inflow/displays-the-cash-inflow-form",
        "role": "displaycashinflow",
        "component": "DisplaysTheCashInflowFormPage",
        "allowedRoles": [
          "displaycashinflow"
        ]
      },
      {
        "route": "/display-cash-inflow/displays-the-query-result",
        "role": "displaycashinflow",
        "component": "DisplaysTheQueryResultPage",
        "allowedRoles": [
          "displaycashinflow"
        ]
      },
      {
        "route": "/display-cash-inflow/prints-a-report-to-the-printer",
        "role": "displaycashinflow",
        "component": "PrintsAReportToThePrinterPage",
        "allowedRoles": [
          "displaycashinflow"
        ]
      }
    ]
